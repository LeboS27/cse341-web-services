{
  "openapi": "3.0.0",
  "info": {
    "title": "CSE 341 Project 2 Library API",
    "description": "Week 03 CRUD API with books and authors collections.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "Local development"
    },
    {
      "url": "https://your-render-app.onrender.com",
      "description": "Replace this with your Render URL"
    }
  ],
  "paths": {
    "/books": {
      "get": { "summary": "Get all books", "responses": { "200": { "description": "List of books" } } },
      "post": {
        "summary": "Create a book",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookInput" } } }
        },
        "responses": { "201": { "description": "Book created" }, "400": { "description": "Validation failed" } }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Get one book",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Book found" }, "404": { "description": "Book not found" } }
      },
      "put": {
        "summary": "Update one book",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookInput" } } }
        },
        "responses": { "204": { "description": "Book updated" }, "400": { "description": "Validation failed" }, "404": { "description": "Book not found" } }
      },
      "delete": {
        "summary": "Delete one book",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "204": { "description": "Book deleted" }, "404": { "description": "Book not found" } }
      }
    },
    "/authors": {
      "get": { "summary": "Get all authors", "responses": { "200": { "description": "List of authors" } } },
      "post": {
        "summary": "Create an author",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorInput" } } }
        },
        "responses": { "201": { "description": "Author created" }, "400": { "description": "Validation failed" } }
      }
    },
    "/authors/{id}": {
      "get": {
        "summary": "Get one author",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Author found" }, "404": { "description": "Author not found" } }
      },
      "put": {
        "summary": "Update one author",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorInput" } } }
        },
        "responses": { "204": { "description": "Author updated" }, "400": { "description": "Validation failed" }, "404": { "description": "Author not found" } }
      },
      "delete": {
        "summary": "Delete one author",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "204": { "description": "Author deleted" }, "404": { "description": "Author not found" } }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "MongoDB ObjectId"
      }
    },
    "schemas": {
      "BookInput": {
        "type": "object",
        "required": ["title", "authorName", "isbn", "genre", "publishedYear", "pages", "language", "available", "rating"],
        "properties": {
          "title": { "type": "string" },
          "authorName": { "type": "string" },
          "isbn": { "type": "string" },
          "genre": { "type": "string" },
          "publishedYear": { "type": "integer" },
          "pages": { "type": "integer" },
          "language": { "type": "string" },
          "available": { "type": "boolean" },
          "rating": { "type": "number" }
        }
      },
      "AuthorInput": {
        "type": "object",
        "required": ["name", "country", "birthYear", "primaryGenre"],
        "properties": {
          "name": { "type": "string" },
          "country": { "type": "string" },
          "birthYear": { "type": "integer" },
          "primaryGenre": { "type": "string" },
          "website": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
