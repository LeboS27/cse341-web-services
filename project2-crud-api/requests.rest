@localBaseUrl = http://localhost:8081
@renderBaseUrl = https://cse341-project2-crud-api-zoq8.onrender.com
@baseUrl = {{renderBaseUrl}}
@token = paste-token-from-login-here

### Home route
GET {{baseUrl}}/

### Register a user and copy the token into @token above
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "CSE Student",
  "email": "student@example.com",
  "password": "Password123!"
}

### Log in and copy the token into @token above
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "Password123!"
}

### Private profile route
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Log out
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### Get all books
GET {{baseUrl}}/books

### Replace the id with a real _id returned from GET /books
GET {{baseUrl}}/books/66f1f53b6b39b57b5a147901

### Create a book
POST {{baseUrl}}/books
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "The Pragmatic Programmer",
  "authorName": "David Thomas and Andrew Hunt",
  "isbn": "9780135957059",
  "genre": "Software Engineering",
  "publishedYear": 2019,
  "pages": 352,
  "language": "English",
  "available": true,
  "rating": 4.8
}

### Update a book
### Replace the id with a real _id returned from GET /books.
PUT {{baseUrl}}/books/66f1f53b6b39b57b5a147901
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Clean Code",
  "authorName": "Robert C. Martin",
  "isbn": "9780132350884",
  "genre": "Software Engineering",
  "publishedYear": 2008,
  "pages": 464,
  "language": "English",
  "available": false,
  "rating": 4.6
}

### Delete a book
### Replace the id with a real _id returned from GET /books.
DELETE {{baseUrl}}/books/66f1f53b6b39b57b5a147901
Authorization: Bearer {{token}}

### Get all authors
GET {{baseUrl}}/authors

### Replace the id with a real _id returned from GET /authors
GET {{baseUrl}}/authors/66f1f53b6b39b57b5a147902

### Create an author
POST {{baseUrl}}/authors
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "David Thomas",
  "country": "United States",
  "birthYear": 1956,
  "primaryGenre": "Software Engineering",
  "website": "https://pragprog.com"
}

### Update an author
### Replace the id with a real _id returned from GET /authors.
PUT {{baseUrl}}/authors/66f1f53b6b39b57b5a147902
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Updated Author",
  "country": "United States",
  "birthYear": 1970,
  "primaryGenre": "Technical Writing",
  "website": "https://example.com"
}

### Delete an author
### Replace the id with a real _id returned from GET /authors.
DELETE {{baseUrl}}/authors/66f1f53b6b39b57b5a147902
Authorization: Bearer {{token}}

