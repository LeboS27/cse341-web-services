@localBaseUrl = http://localhost:8082
@renderBaseUrl = https://cse341-final-project-api.onrender.com
@baseUrl = {{renderBaseUrl}}
@token = paste-oauth-token-here

### Home route
GET {{baseUrl}}/

### Check whether GitHub OAuth is configured
GET {{baseUrl}}/auth/oauth/status

### Open this route in a browser to log in with GitHub
GET {{baseUrl}}/auth/github

### Current OAuth user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Log out
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### Get all events
GET {{baseUrl}}/events

### Replace with a real _id from GET /events
GET {{baseUrl}}/events/66f1f53b6b39b57b5a147911

### Create an event
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "API Showcase Night",
  "description": "Students present APIs, Swagger docs, and MongoDB updates.",
  "location": "Innovation Lab",
  "startDate": "2026-11-01T17:00:00.000Z",
  "endDate": "2026-11-01T19:00:00.000Z",
  "category": "academic",
  "capacity": 50,
  "isPublic": true,
  "organizerEmail": "showcase@example.edu"
}

### Update an event
PUT {{baseUrl}}/events/66f1f53b6b39b57b5a147911
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Updated Event",
  "description": "Updated description for the final project video.",
  "location": "Library Room 204",
  "startDate": "2026-11-02T17:00:00.000Z",
  "endDate": "2026-11-02T19:00:00.000Z",
  "category": "service",
  "capacity": 80,
  "isPublic": false,
  "organizerEmail": "updated@example.edu"
}

### Delete an event
DELETE {{baseUrl}}/events/66f1f53b6b39b57b5a147911
Authorization: Bearer {{token}}

### Get all volunteers
GET {{baseUrl}}/volunteers

### Replace with a real _id from GET /volunteers
GET {{baseUrl}}/volunteers/66f1f53b6b39b57b5a147912

