  "email": "sam@example.edu",
  "phone": "+12085550155",
  "role": "usher",
  "availability": "weekday evenings",
  "status": "active"
}

### Update a volunteer
PUT {{baseUrl}}/volunteers/66f1f53b6b39b57b5a147912
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Updated",
  "lastName": "Volunteer",
  "email": "updated@example.edu",
  "phone": "+12085550156",
